#pragma kernel CSMain

// OIT resolve: gather per-pixel linked list, insertion sort front-to-back,
// under-composite, and write premultiplied RGBA to OIT_ResolveTexture.
//
// Node layout (must match OITGeometry.shader and OITBufferManager):
//   [0] packedColor — RGBA8: R in bits 31-24
//   [1] depth       — asuint(float) NDC depth; smaller = closer to camera
//   [2] next        — previous head index; 0xFFFFFFFF = sentinel

#define MAX_LAYERS 24
#define HEAD_SENTINEL 0xFFFFFFFFu

struct OITNode
{
    uint packedColor;
    uint depth;
    uint next;
};

StructuredBuffer<uint>    OIT_HeadBuffer;
StructuredBuffer<OITNode> OIT_NodeBuffer;

RWTexture2D<float4>       OIT_ResolveTexture;

int _OIT_ScreenWidth;
int _OIT_ScreenHeight;

// ---------------------------------------------------------------------------
// Unpack RGBA8 packed uint to float4 (linear, [0..1]).
// Matches OITColorPacking.cs: R in bits 31-24.
// ---------------------------------------------------------------------------
float4 UnpackRGBA(uint packed)
{
    float r = ((packed >> 24) & 0xFFu) / 255.0;
    float g = ((packed >> 16) & 0xFFu) / 255.0;
    float b = ((packed >>  8) & 0xFFu) / 255.0;
    float a = ( packed        & 0xFFu) / 255.0;
    return float4(r, g, b, a);
}

// ---------------------------------------------------------------------------
// Insertion sort a small array of (depth, nodeIndex) pairs front-to-back.
// Front-to-back means ascending depth (smaller NDC depth = closer).
// ---------------------------------------------------------------------------
void InsertionSort(inout uint depths[MAX_LAYERS], inout uint indices[MAX_LAYERS], int count)
{
    for (int i = 1; i < count; i++)
    {
        uint keyDepth = depths[i];
        uint keyIndex = indices[i];
        int j = i - 1;
        while (j >= 0 && depths[j] > keyDepth)
        {
            depths[j + 1]  = depths[j];
            indices[j + 1] = indices[j];
            j--;
        }
        depths[j + 1]  = keyDepth;
        indices[j + 1] = keyIndex;
    }
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _OIT_ScreenWidth || (int)id.y >= _OIT_ScreenHeight)
        return;

    uint pixelIndex = id.y * (uint)_OIT_ScreenWidth + id.x;
    uint head = OIT_HeadBuffer[pixelIndex];

    // No fragments at this pixel — leave resolve texture at zero (transparent black).
    if (head == HEAD_SENTINEL)
    {
        OIT_ResolveTexture[id.xy] = float4(0, 0, 0, 0);
        return;
    }

    // Gather up to MAX_LAYERS fragments from the linked list.
    uint depths[MAX_LAYERS];
    uint nodeIndices[MAX_LAYERS];
    int  count = 0;

    uint cur = head;
    while (cur != HEAD_SENTINEL && count < MAX_LAYERS)
    {
        depths[count]      = OIT_NodeBuffer[cur].depth;
        nodeIndices[count] = cur;
        count++;
        cur = OIT_NodeBuffer[cur].next;
    }

    InsertionSort(depths, nodeIndices, count);

    // Under-compositing front-to-back: result = front + back * (1 - front.alpha)
    float4 result = float4(0, 0, 0, 0);
    for (int i = 0; i < count; i++)
    {
        float4 color = UnpackRGBA(OIT_NodeBuffer[nodeIndices[i]].packedColor);
        result.rgb += color.rgb * color.a * (1.0 - result.a);
        result.a   += color.a  *            (1.0 - result.a);
    }

    OIT_ResolveTexture[id.xy] = saturate(result);
}
